# Copy to .env.local for local work. Nothing here is a real key. Never commit real keys.

# "public" (default) shows national 2026 Medicare reference prices only.
# "internal" adds New York locality prices (Rest of NY 13282/99 default), older years, and the internal screens.
# Fixed at build time. Set it on the build, not just at runtime.
VITE_DEMO_MODE=public

# Optional. Shows an "Open in my email app" button on the Request page. The visitor's own mail app sends it.
# VITE_INVOICE_REQUEST_EMAIL=

# Stripe, TEST MODE ONLY. All unset by default, so the card button is hidden. See docs/BILLING.md.
# BILLING_MODE=test
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_STOPWATCH=price_...
# STRIPE_PRICE_PARALLEL=price_...
# STRIPE_PRICE_WRAP=price_...
# APP_URL=http://localhost:8080
