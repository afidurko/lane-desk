# Copy to .env.local for local work. Nothing here is a real key. Never commit real keys.

# "public" (default) shows national 2026 Medicare reference prices only.
# "internal" adds New York locality prices (Rest of NY 13282/99 default), older years, and the internal screens.
# Fixed at build time. Set it on the build, not just at runtime.
VITE_DEMO_MODE=public

# Optional. Shows an "Open in my email app" button on the Request page. The visitor's own mail app sends it.
# VITE_INVOICE_REQUEST_EMAIL=

# Stripe, TEST MODE ONLY. All unset by default, so the card button is hidden. See docs/BILLING.md.
# BILLING_MODE=test
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_STOPWATCH=price_...
# STRIPE_PRICE_PARALLEL=price_...
# STRIPE_PRICE_WRAP=price_...
# Origin for Stripe success/cancel/return URLs. Never taken from the request host.
# REQUIRED on Vercel (preview and production) and with NODE_ENV=production: must be https. Missing there = card payment off.
# Local dev without it uses http://localhost:8080.
# APP_URL=https://your-preview-host.example

# Sign-in (broker OAuth). The client secret is env only: there is no fallback in the code.
# With auth on (VITE_AUTH_ENABLED not "false") the server refuses to start without GROK_AUTH_CLIENT_SECRET.
# GROK_AUTH_CLIENT_SECRET=
# GROK_AUTH_CLIENT_ID=
# VITE_AUTH_ENABLED=false

# Internal builds. `vite build` with VITE_DEMO_MODE=internal is refused unless LANE_INTERNAL_BUILD=1 (use `npm run build:internal`),
# and it is refused on any Vercel build even with the flag. Never set either on Vercel.
# LANE_INTERNAL_BUILD=1
